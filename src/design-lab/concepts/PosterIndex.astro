---
import { Image } from 'astro:assets';
import { loadDesignLabContent } from '../content';

const { projects, music, experience } = await loadDesignLabContent();
const [heroProject] = projects;
---

<div class="poster-index" data-poster-index>
  <section class="poster-hero" aria-labelledby="poster-title">
    <div class="poster-hero__copy">
      <p class="poster-kicker">Amir Rostami — Toronto, Canada</p>
      <h1 id="poster-title"><span class="poster-hero__headline-line">Curious systems for</span><span class="poster-hero__headline-line">people to meet inside.</span></h1>
      <p class="poster-hero__statement">Creative technologist. Musician. Professional maker of curious things. I create immersive experiences, software, and sound that bring people together in unexpected ways.</p>
      <p class="poster-hero__availability">Open to employment and freelance work.</p>
    </div>
    <a class="poster-hero__image" href={`/work/${heroProject.id}/`} aria-label={`View ${heroProject.data.title}`}>
      <Image src={heroProject.data.hero} alt={heroProject.data.heroAlt} widths={[600, 900, 1200]} sizes="(max-width: 48rem) 74vw, 38vw" loading="eager" fetchpriority="high" />
    </a>
  </section>

  <section id="work" class="poster-work" aria-labelledby="poster-work-title">
    <div class="poster-work__index" data-lab-pin>
      <p>01 / Work</p>
      <h2 id="poster-work-title">An index of things made with and for other people.</h2>
    </div>
    <div class="poster-plates">
      {projects.map((project, index) => (
        <article class:list={['poster-plate', `poster-plate--${index + 1}`]} data-lab-project data-lab-stack>
          <p class="poster-plate__number">0{index + 1}</p>
          <a class="poster-plate__image" href={`/work/${project.id}/`} aria-label={`View ${project.data.title}`}>
            <span data-lab-scale><Image src={project.data.hero} alt={project.data.heroAlt} widths={[640, 960, 1280]} sizes="(max-width: 48rem) calc(100vw - 3rem), 48vw" /></span>
          </a>
          <div class="poster-plate__copy">
            <h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3>
            <p>{project.data.cardSummary}</p>
            <span>{project.data.year ?? 'Selected work'}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="music" class="poster-music" aria-labelledby="poster-music-title">
    <div class="poster-section-head" data-lab-reveal>
      <p>02 / Music</p>
      <h2 id="poster-music-title">Sound, repeated until it finds its shape.</h2>
    </div>
    <div class="poster-marquee" data-poster-marquee aria-label="Featured music">
      <div class="poster-marquee__track" data-lab-marquee>
        {music.map((track) => <a data-lab-track href={track.data.url} target="_blank" rel="noreferrer">{track.data.title} <span aria-hidden="true">—</span></a>)}
        <span aria-hidden="true">Float — Flow — La Paloma —</span>
      </div>
    </div>
  </section>

  <section id="experience" class="poster-experience" aria-labelledby="poster-experience-title">
    <div class="poster-section-head" data-lab-reveal>
      <p>03 / Experience</p>
      <h2 id="poster-experience-title">A practice moving between studios, systems, and classrooms.</h2>
    </div>
    <ol>
      {experience.map((entry, index) => (
        <li data-lab-stack>
          <span>0{index + 1}</span>
          <h3>{entry.data.role}</h3>
          <p>{entry.data.organization}</p>
          <p>{entry.data.period}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="contact" class="poster-contact" aria-labelledby="poster-contact-title">
    <p>04 / Contact</p>
    <h2 id="poster-contact-title">Have a project with a little room for wonder?</h2>
    <a href="/contact/">Contact Amir <span aria-hidden="true">↗</span></a>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { initializeDesignLabMotion } from '../motion';

  const root = document.querySelector<HTMLElement>('[data-poster-index]');
  if (root) {
    initializeDesignLabMotion(root);
    const marquee = root.querySelector<HTMLElement>('[data-poster-marquee]');
    const updateMarquee = () => {
      if (!marquee) return;
      const track = marquee.querySelector<HTMLElement>('[data-lab-marquee]');
      if (!track) return;
      gsap.getTweensOf(track).forEach((tween) => {
        if (marquee.matches(':hover, :focus-within')) tween.pause();
        else tween.play();
      });
    };
    marquee?.addEventListener('mouseenter', updateMarquee);
    marquee?.addEventListener('mouseleave', updateMarquee);
    marquee?.addEventListener('focusin', updateMarquee);
    marquee?.addEventListener('focusout', updateMarquee);
  }
</script>

<style>
  .poster-index { --bone: #eee7d7; --espresso: #2d211d; --graphite: #4d4741; --mint: #96b6a2; background: var(--bone); color: var(--espresso); overflow: clip; }
  .poster-index :is(h1, h2, h3, p) { margin: 0; }
  .poster-index a { text-decoration-thickness: 1px; text-underline-offset: .22em; }
  .poster-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(14rem, 5fr); min-height: min(52rem, calc(100svh - 5rem)); padding: clamp(2rem, 5vw, 5rem); position: relative; }
  .poster-hero__copy { align-self: start; display: grid; gap: clamp(1.2rem, 3vw, 2.5rem); min-width: 0; position: relative; z-index: 1; }
  .poster-kicker, .poster-hero__availability, .poster-section-head > p, .poster-work__index > p, .poster-contact > p, .poster-plate__number, .poster-plate__copy span, .poster-experience li > span { font-size: .76rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: clamp(3.75rem, 4.1vw, 4.5rem); font-weight: 500; letter-spacing: -.085em; line-height: .83; max-width: 92rem; width: 100%; }.poster-hero__headline-line { display: block; white-space: nowrap; }
  .poster-hero__statement { font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1.35; max-width: 37rem; }
  .poster-hero__availability { color: var(--graphite); }
  .poster-hero__image { align-self: end; aspect-ratio: .8; border-radius: 55% 0 0 0; display: block; justify-self: end; margin-bottom: clamp(0rem, 4vw, 4rem); max-width: 32rem; overflow: hidden; width: 100%; }
  .poster-hero__image :global(img), .poster-plate__image :global(img) { height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.65,.2,1); width: 100%; }
  .poster-hero__image:hover :global(img), .poster-hero__image:focus-visible :global(img), .poster-plate__image:hover :global(img), .poster-plate__image:focus-visible :global(img) { transform: scale(1.045); }
  .poster-work { border-top: 1px solid color-mix(in srgb, var(--espresso), transparent 55%); display: grid; grid-template-columns: minmax(15rem, 4fr) minmax(0, 8fr); padding-inline: clamp(1.5rem, 5vw, 5rem); }
  .poster-work__index { align-self: start; border-right: 1px solid color-mix(in srgb, var(--espresso), transparent 55%); min-height: 50svh; padding: clamp(2rem, 5vw, 5rem) clamp(1.5rem, 4vw, 4rem) 2rem 0; }
  .poster-work__index h2, .poster-section-head h2 { font-size: clamp(2rem, 4vw, 4.6rem); font-weight: 500; letter-spacing: -.07em; line-height: .94; margin-top: 1.35rem; max-width: 13ch; }
  .poster-plates { display: grid; min-width: 0; padding-block: clamp(2rem, 6vw, 6rem); }
  .poster-plate { border-top: 1px solid color-mix(in srgb, var(--espresso), transparent 55%); display: grid; gap: 1rem; grid-template-columns: 2.6rem minmax(0, 1fr); padding: 1rem 0; }
  .poster-plate--2 { margin-left: 10%; } .poster-plate--3 { margin-left: 2%; }
  .poster-plate__image { aspect-ratio: 16 / 9; display: block; grid-column: 2; overflow: hidden; }
  .poster-plate__image > span { display: block; height: 100%; width: 100%; }
  .poster-plate__copy { display: grid; gap: .55rem; grid-column: 2; grid-template-columns: minmax(9rem, .55fr) minmax(0, 1fr) auto; }
  .poster-plate__copy h3 { font-size: clamp(1.3rem, 2.2vw, 2.25rem); font-weight: 500; letter-spacing: -.05em; line-height: 1; }
  .poster-plate__copy p { max-width: 30rem; } .poster-plate__copy span { align-self: start; text-align: right; }
  .poster-music, .poster-experience { border-top: 1px solid color-mix(in srgb, var(--espresso), transparent 55%); padding: clamp(2.5rem, 7vw, 7rem) clamp(1.5rem, 5vw, 5rem); }
  .poster-section-head { display: grid; gap: 1rem; grid-template-columns: 2.6rem minmax(0, 1fr); }.poster-section-head > p { grid-column: 1; }.poster-section-head h2 { grid-column: 2; margin-top: 0; }
  .poster-marquee { border-block: 1px solid var(--espresso); margin-top: clamp(2rem, 5vw, 5rem); overflow: hidden; padding-block: .55rem; white-space: nowrap; }
  .poster-marquee__track { align-items: baseline; display: inline-flex; font-size: clamp(2rem, 6vw, 6.5rem); font-weight: 500; letter-spacing: -.075em; line-height: 1; width: max-content; }
  .poster-marquee__track a, .poster-marquee__track > span { margin-right: .35em; text-decoration: none; }.poster-marquee__track a:hover { color: var(--mint); }
  .poster-experience ol { list-style: none; margin: clamp(2.5rem, 6vw, 6rem) 0 0; padding: 0; }.poster-experience li { border-top: 1px solid color-mix(in srgb, var(--espresso), transparent 55%); display: grid; gap: 1rem; grid-template-columns: 2.6rem minmax(9rem, .6fr) minmax(10rem, 1fr) auto; padding: 1.1rem 0; }.poster-experience h3 { font-size: clamp(1.25rem, 2vw, 2rem); font-weight: 500; letter-spacing: -.05em; line-height: 1; }.poster-experience li > p { color: var(--graphite); }.poster-experience li > p:last-child { font-size: .8rem; text-align: right; }
  .poster-contact { background: var(--espresso); color: var(--bone); min-height: 56svh; padding: clamp(2rem, 5vw, 5rem); }.poster-contact h2 { font-size: clamp(3rem, 8vw, 8rem); font-weight: 500; letter-spacing: -.085em; line-height: .86; margin-top: clamp(3rem, 14vw, 12rem); max-width: 13ch; }.poster-contact > a { color: var(--mint); display: inline-block; font-size: clamp(1.3rem, 2.5vw, 2rem); margin-top: 2rem; }
  @media (max-width: 48rem) { .poster-hero { grid-template-columns: minmax(0, 1fr); min-height: auto; }.poster-hero__headline-line { white-space: normal; }.poster-hero__image { margin-top: 2rem; max-width: 21rem; }.poster-work { grid-template-columns: minmax(0, 1fr); }.poster-work__index { border-right: 0; min-height: auto; padding-right: 0; }.poster-plate--2, .poster-plate--3 { margin-left: 0; }.poster-plate__copy { grid-template-columns: minmax(0, 1fr) auto; }.poster-plate__copy p { grid-column: 1 / -1; }.poster-experience li { grid-template-columns: 2.2rem minmax(0, 1fr); }.poster-experience li > p { grid-column: 2; }.poster-experience li > p:last-child { grid-column: 2; text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .poster-hero__image :global(img), .poster-plate__image :global(img) { transition: none; }.poster-marquee__track { transform: none !important; } }
</style>
