---
import { Image } from 'astro:assets';
import { DESIGN_LAB_IDENTITY, DESIGN_LAB_SUPPORTING_STATEMENT, loadDesignLabContent } from '../content';

const { projects, music, experience } = await loadDesignLabContent();
---

<div class="clau-poster-wall" data-clau-poster-wall>
  <section class="clau-hero" aria-labelledby="clau-title">
    <div class="clau-hero__poster">
      <p>Amir Rostami / Toronto, Canada</p>
      <h1 id="clau-title"><span>CURIOUS</span><span>THINGS</span><span>MOVE.</span></h1>
      <p class="clau-hero__identity">{DESIGN_LAB_IDENTITY}</p>
      <p class="clau-hero__supporting">{DESIGN_LAB_SUPPORTING_STATEMENT}</p>
      <p class="clau-hero__availability">Open to employment and freelance work.</p>
    </div>
  </section>

  <section id="work" class="clau-work" aria-labelledby="clau-work-title">
    <p>01 / The poster wall</p>
    <h2 id="clau-work-title">Projects, enlarged until they become places.</h2>
    <div class="clau-project-wall" data-clau-project-wall data-lab-scrub-reveal-group>
      {projects.map((project, index) => (
        <article class:list={['clau-project', `clau-project--${index + 1}`]} data-lab-project>
          <p>0{index + 1} / {project.data.year ?? 'Selected work'}</p>
          <h3>
            <a href={`/work/${project.id}/`}>
              {project.data.title.split(' ').map((word, index) => <><span class="clau-project__word" data-lab-scrub-reveal>{word}</span>{index < project.data.title.split(' ').length - 1 && ' '}</>)}
              <span class="clau-project__aperture" data-lab-scale>
                <Image
                  src={project.data.hero}
                  alt={project.data.heroAlt}
                  widths={[400, 640, 960]}
                  sizes="(max-width: 48rem) 42vw, 20vw"
                />
              </span>
            </a>
          </h3>
          <p>{project.data.cardSummary}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="music" class="clau-music" aria-labelledby="clau-music-title">
    <p>02 / Music</p>
    <h2 id="clau-music-title">Recordings on repeat.</h2>
    <div class="clau-marquee" data-clau-marquee tabindex="0" role="region" aria-label="Moving featured music titles"><div data-lab-marquee>{[...music, ...music].map((track) => <span>{track.data.title} ✳</span>)}</div></div>
    <div class="clau-listening" aria-label="Featured music">
      {music.map((track, index) => (
        <a data-lab-track href={track.data.url} target="_blank" rel="noreferrer"><span>0{index + 1}</span><strong>{track.data.title}</strong><span>Listen ↗</span></a>
      ))}
    </div>
    <a class="clau-music__archive" data-music-archive href="/music/">Explore the full music archive <span aria-hidden="true">↗</span></a>
  </section>

  <section id="experience" class="clau-experience" aria-labelledby="clau-experience-title">
    <p>03 / Experience</p>
    <h2 id="clau-experience-title">Engineering, art, and research in public.</h2>
    <ol>
      {experience.map((entry, index) => (
        <li data-lab-stack><span>0{index + 1}</span><div><h3>{entry.data.role}</h3><p>{entry.data.organization}</p></div><p>{entry.data.period}</p></li>
      ))}
    </ol>
  </section>

  <section id="contact" class="clau-contact" aria-labelledby="clau-contact-title">
    <p>04 / Contact</p>
    <h2 id="clau-contact-title">Make the next thing move.</h2>
    <a href="/contact/">Contact Amir <span aria-hidden="true">↗</span></a>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { initializeDesignLabMotion, registerDesignLabCleanup } from '../motion';

  const root = document.querySelector<HTMLElement>('[data-clau-poster-wall]');
  if (root) {
    const cleanupMotion = initializeDesignLabMotion(root);

    const marquee = root.querySelector<HTMLElement>('[data-clau-marquee]');
    const updateMarquee = () => {
      const track = marquee?.querySelector<HTMLElement>('[data-lab-marquee]');
      if (!marquee || !track) return;
      gsap.getTweensOf(track).forEach((tween) => marquee.matches(':hover, :focus-within') ? tween.pause() : tween.play());
    };
    marquee?.addEventListener('mouseenter', updateMarquee);
    marquee?.addEventListener('mouseleave', updateMarquee);
    marquee?.addEventListener('focusin', updateMarquee);
    marquee?.addEventListener('focusout', updateMarquee);
    registerDesignLabCleanup(() => {
      cleanupMotion();
      marquee?.removeEventListener('mouseenter', updateMarquee);
      marquee?.removeEventListener('mouseleave', updateMarquee);
      marquee?.removeEventListener('focusin', updateMarquee);
      marquee?.removeEventListener('focusout', updateMarquee);
    });
  }
</script>

<style>
  .clau-poster-wall { --poster-field: #8993ff; --poster-ink: #121212; --poster-signal: #b9ff55; background: var(--poster-field); color: var(--poster-ink); overflow: clip; }
  .clau-poster-wall :is(h1, h2, h3, p) { margin: 0; }.clau-poster-wall a { text-underline-offset: .18em; text-decoration-thickness: 1px; }
  :global(body[data-concept="clau-poster-wall"] .concept-navigation) { background: var(--poster-field); color: var(--poster-ink); font-size: .73rem; font-weight: 700; letter-spacing: .09em; padding-block: 1rem; text-transform: uppercase; }
  .clau-hero { align-items: center; background: var(--poster-field); display: grid; min-height: min(52rem, calc(100svh - 3.5rem)); padding: clamp(1.5rem, 5vw, 5rem); }
  .clau-hero__poster { display: grid; justify-items: center; margin-inline: auto; max-width: 92rem; text-align: center; width: 100%; }.clau-hero__poster > p:first-child, .clau-hero__availability, .clau-work > p, .clau-music > p, .clau-experience > p, .clau-contact > p, .clau-project > p:first-child { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .clau-hero h1 { font-size: clamp(5rem, 15.5vw, 17rem); font-weight: 700; letter-spacing: -.12em; line-height: .68; margin-top: clamp(3rem, 9vw, 8rem); max-width: 92rem; width: 100%; }.clau-hero h1 span { display: block; }
  .clau-hero__identity { font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.3; margin-top: clamp(2.5rem, 5vw, 4.5rem); max-width: 39rem; }.clau-hero__supporting { line-height: 1.4; margin-top: 1rem; max-width: 42rem; }.clau-hero__availability { background: var(--poster-signal); margin-top: 1.3rem; padding: .2rem .45rem; }
  .clau-work, .clau-music, .clau-experience { padding: clamp(4rem, 9vw, 9rem) clamp(1.5rem, 5vw, 5rem); }.clau-work h2, .clau-music h2, .clau-experience h2 { font-size: clamp(2.7rem, 5vw, 6rem); font-weight: 700; letter-spacing: -.095em; line-height: .78; margin-top: 1.4rem; max-width: 12ch; }
  .clau-project-wall { display: grid; gap: clamp(5rem, 12vw, 12rem); margin-top: clamp(4rem, 10vw, 10rem); }.clau-project { display: grid; gap: 1.25rem; }.clau-project--2 { margin-left: 13%; }.clau-project--3 { margin-left: 4%; }
  .clau-project h3 { font-size: clamp(4rem, 12vw, 14rem); font-weight: 700; letter-spacing: -.12em; line-height: .7; max-width: 92rem; }.clau-project h3 a { align-items: center; display: flex; flex-wrap: wrap; gap: .1em .18em; text-decoration: none; }.clau-project h3 a:hover, .clau-project h3 a:focus-visible { color: var(--poster-ink); text-decoration: underline; text-decoration-thickness: .04em; }
  .clau-project__aperture { display: inline-block; height: .75em; overflow: hidden; width: 1.45em; }.clau-project__aperture :global(img) { height: 100%; object-fit: cover; transition: opacity .55s ease, transform .55s cubic-bezier(.2,.7,.2,1); width: 100%; }.clau-project h3 a:hover .clau-project__aperture :global(img), .clau-project h3 a:focus-visible .clau-project__aperture :global(img) { transform: scale(1.08); }
  .clau-project > p:last-child { font-size: clamp(1rem, 1.5vw, 1.35rem); line-height: 1.35; max-width: 36rem; }
  .clau-music { background: var(--poster-ink); color: var(--poster-field); }.clau-marquee { background: var(--poster-signal); color: var(--poster-ink); margin: clamp(3rem, 7vw, 7rem) calc(clamp(1.5rem, 5vw, 5rem) * -1) 0; overflow: hidden; white-space: nowrap; }.clau-marquee > div { display: inline-flex; font-size: clamp(4rem, 12vw, 14rem); font-weight: 700; letter-spacing: -.12em; line-height: .75; padding-block: .08em; width: max-content; }.clau-marquee span { margin-right: .24em; }
  .clau-listening { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: clamp(2rem, 5vw, 5rem); }.clau-listening a { display: grid; gap: .8rem; text-decoration: none; }.clau-listening strong { font-size: clamp(1.8rem, 3.3vw, 4rem); font-weight: 700; letter-spacing: -.075em; line-height: .8; }.clau-listening a:hover strong, .clau-listening a:focus-visible strong { color: var(--poster-signal); }.clau-listening span { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }.clau-music__archive { display: inline-block; font-weight: 700; margin-top: 2rem; }
  .clau-experience ol { list-style: none; margin: clamp(3rem, 7vw, 7rem) 0 0; padding: 0; }.clau-experience li { display: grid; gap: 1rem; grid-template-columns: 2rem minmax(12rem, 1fr) auto; padding: 1rem 0; }.clau-experience li > span, .clau-experience li > p { font-size: .73rem; font-weight: 700; }.clau-experience h3 { font-size: clamp(1.4rem, 2.3vw, 2.6rem); font-weight: 700; letter-spacing: -.06em; line-height: .9; }.clau-experience li div p { margin-top: .3rem; }.clau-experience li > p { text-align: right; }
  .clau-contact { background: var(--poster-signal); min-height: 68svh; padding: clamp(2rem, 5vw, 5rem); }.clau-contact h2 { font-size: clamp(4rem, 11vw, 12rem); font-weight: 700; letter-spacing: -.12em; line-height: .7; margin-top: clamp(5rem, 13vw, 11rem); max-width: 10ch; }.clau-contact > a { display: inline-block; font-size: clamp(1.25rem, 2.4vw, 2.3rem); margin-top: 2rem; }
  @media (max-width: 48rem) { .clau-hero { min-height: min(46rem, calc(100svh - 3.5rem)); }.clau-hero h1 { font-size: clamp(4.2rem, 20vw, 7rem); margin-top: 4rem; }.clau-project--2, .clau-project--3 { margin-left: 0; }.clau-project h3 { font-size: clamp(3.8rem, 18vw, 7rem); }.clau-listening { grid-template-columns: minmax(0, 1fr); }.clau-experience li { grid-template-columns: 2rem minmax(0, 1fr); }.clau-experience li > p { grid-column: 2; text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .clau-poster-wall [data-lab-scrub-reveal], .clau-poster-wall [data-lab-stack] { opacity: 1 !important; transform: none !important; }.clau-marquee > div { transform: none !important; }.clau-project__aperture :global(img) { transition: none; } }
</style>
