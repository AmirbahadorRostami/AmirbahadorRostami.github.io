---
import { getCollection } from 'astro:content';
import MusicGrid from '../components/music/MusicGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { sortByOrder } from '../lib/content';

const music = sortByOrder((await getCollection('music')).filter(({ data }) => !data.draft));
const featuredMusic = music.filter(({ data }) => data.featured);
const catalogMusic = music.filter(({ data }) => !data.featured);
---

<BaseLayout title="Music | Amir Bahador Rostami" canonicalPath="/music/">
  <section class="container music-archive" aria-labelledby="music-title">
    <p class="eyebrow">Listening room</p>
    <h1 id="music-title">Things I make with sound.</h1>
    <p class="music-archive__intro">Music is another way I build atmosphere, follow curiosity, and make space for people to feel something together.</p>
    {(SITE.spotifyUrl || SITE.soundCloudUrl) && (
      <nav aria-label="Music profiles" class="music-archive__profiles">
        {SITE.spotifyUrl && <a href={SITE.spotifyUrl} rel="noopener noreferrer" target="_blank">Spotify profile</a>}
        {SITE.soundCloudUrl && <a href={SITE.soundCloudUrl} rel="noopener noreferrer" target="_blank">SoundCloud profile</a>}
      </nav>
    )}

    <section class="music-archive__group" data-music-group="featured" aria-labelledby="featured-tracks-title">
      <h2 id="featured-tracks-title">Featured tracks</h2>
      <MusicGrid records={featuredMusic} />
    </section>

    <section class="music-archive__group" data-music-group="catalog" aria-labelledby="catalog-tracks-title">
      <h2 id="catalog-tracks-title">More music</h2>
      <MusicGrid records={catalogMusic} />
    </section>
  </section>
</BaseLayout>

<style>
  .music-archive > h1 { max-width: 11ch; }
  .music-archive__intro { color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); margin: 1.5rem 0 0; max-width: 55ch; }
  .music-archive__profiles { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .music-archive__profiles a { border: 1px solid var(--line); color: var(--signal-text); padding: .5rem .75rem; text-underline-offset: .2em; }
  .music-archive__group { margin-top: clamp(3rem, 8vw, 6rem); }
  .music-archive__group h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -.04em; margin: 0; }
</style>
