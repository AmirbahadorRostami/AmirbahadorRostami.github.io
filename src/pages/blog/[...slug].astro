---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageBackdrop from '../../components/layout/SubpageBackdrop.astro';
import { SITE } from '../../config/site';
import { formatBlogDate, getPublishedBlogPosts } from '../../lib/blog';

export async function getStaticPaths() {
  return (await getPublishedBlogPosts()).map((post) => ({
    params: { slug: post.id }, props: { post },
  }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Amir Bahador Rostami`} description={post.data.description} canonicalPath={`/blog/${post.id}/`} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta name="author" content={SITE.name} />
  </Fragment>
  <article class="container blog-article subpage-hero" aria-labelledby="post-title">
    <SubpageBackdrop />
    <header class="blog-article__header">
      <a class="text-link" href="/blog/">Back to blog</a>
      <p class="eyebrow"><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatBlogDate(post.data.pubDate)}</time> / {SITE.name}</p>
      <h1 id="post-title">{post.data.title}</h1>
      <p class="blog-article__description">{post.data.description}</p>
    </header>
    <div class="blog-prose"><Content /></div>
    <footer class="blog-article__footer"><a class="text-link" href="/blog/">All posts</a></footer>
  </article>
</BaseLayout>

<style>
  :global(main):has(> .blog-article) { overflow-x: clip; }
  .blog-article { max-width: 64rem; }
  .blog-article__header h1 { font-size: clamp(2.75rem, 6.5vw, 6rem); line-height: 1.02; max-width: 18ch; overflow-wrap: anywhere; }
  .blog-article__header .eyebrow { margin-top: 2rem; }
  .blog-article__description { color: var(--muted); font-size: clamp(1.2rem, 2.5vw, 1.5rem); line-height: 1.6; margin-top: 2rem; max-width: 50ch; overflow-wrap: anywhere; }
  .blog-prose { border-top: 1px solid var(--line); font-size: clamp(1.0625rem, 1.5vw, 1.25rem); line-height: 1.8; margin-top: clamp(3rem, 7vw, 5rem); max-width: 68ch; overflow-wrap: anywhere; padding-top: 2rem; }
  .blog-prose :global(h2), .blog-prose :global(h3), .blog-prose :global(h4) { font-weight: 500; letter-spacing: -.025em; line-height: 1.25; margin: 2.5rem 0 1rem; }
  .blog-prose :global(h2) { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .blog-prose :global(h3) { font-size: 1.5rem; }
  .blog-prose :global(p), .blog-prose :global(ul), .blog-prose :global(ol) { margin: 0 0 1.5rem; }
  .blog-prose :global(li + li) { margin-top: .5rem; }
  .blog-prose :global(a) { color: var(--signal-text); text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .blog-prose :global(a:hover) { color: var(--paper); }
  .blog-prose :global(blockquote) { border-left: 2px solid var(--signal); color: var(--muted); margin: 2rem 0; padding: .25rem 0 .25rem 1.5rem; }
  .blog-prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .blog-prose :global(code) { font-family: var(--font-mono); font-size: .85em; }
  .blog-prose :global(:not(pre) > code) { background: var(--surface-raised); padding: .15em .35em; }
  .blog-prose :global(pre) { border: 1px solid var(--line); font-size: .875rem; line-height: 1.7; max-width: 100%; overflow-x: auto; padding: 1.25rem; }
  .blog-prose :global(img) { height: auto; margin-block: 2rem; }
  .blog-prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin-block: 3rem; }
  .blog-prose :global(.report-table) { margin-block: 1.5rem 2rem; overflow-x: auto; }
  .blog-prose :global(.report-table table) { border-collapse: collapse; font-size: .9375rem; line-height: 1.5; min-width: 38rem; width: 100%; }
  .blog-prose :global(.report-table th), .blog-prose :global(.report-table td) { border: 1px solid var(--line); padding: .75rem; text-align: left; vertical-align: top; }
  .blog-prose :global(.report-table th) { background: var(--surface-raised); font-weight: 600; }
  .blog-prose :global(.report-table td) { background: var(--surface); }
  .blog-article__footer { border-top: 1px solid var(--line); margin-top: 4rem; padding-top: 1.5rem; }
</style>
