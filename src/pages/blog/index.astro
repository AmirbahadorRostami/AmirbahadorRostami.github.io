---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubpageBackdrop from '../../components/layout/SubpageBackdrop.astro';
import { formatBlogDate, getPublishedBlogPosts } from '../../lib/blog';

const posts = await getPublishedBlogPosts();
---

<BaseLayout title="Blog | Amir Bahador Rostami" canonicalPath="/blog/" description="Notes and reflections on creative technology, art, code, and sound by Amir Bahador Rostami.">
  <section class="container blog-archive subpage-hero" aria-labelledby="blog-title">
    <SubpageBackdrop />
    <header>
      <p class="eyebrow">Notes / Ideas / Process</p>
      <h1 id="blog-title">Blog</h1>
      <p class="blog-archive__intro">Thoughts in progress. Notes on making things with art, code, and sound.</p>
    </header>
    {posts.length > 0 ? (
      <ol class="blog-posts" aria-label="Blog posts">
        {posts.map((post) => (
          <li>
            <article class="blog-post">
              <div>
                <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatBlogDate(post.data.pubDate)}</time>
              </div>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <div class="blog-empty">
        <p class="eyebrow">An open notebook</p>
        <h2>The first entry is still taking shape.</h2>
        <p>There are no posts here yet. In the meantime, explore the work and experiments.</p>
        <div class="blog-empty__links">
          <a class="text-link" href="/work/">Explore the work</a>
          <a class="text-link" href="/experiments/">Visit experiments</a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .blog-archive h1 { font-size: clamp(4.5rem, 12vw, 10rem); }
  .blog-archive__intro { color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); margin: 2rem 0 0; max-width: 42ch; }
  .blog-posts { list-style: none; margin: clamp(4rem, 8vw, 7rem) 0 0; padding: 0; }
  .blog-post { border-top: 1px solid var(--line); padding-block: clamp(2rem, 4vw, 3.5rem); }
  .blog-post time { color: var(--muted); display: block; font-family: var(--font-mono); font-size: .75rem; margin-top: 1.25rem; text-align: right; }
  .blog-post h2 { font-size: clamp(1.75rem, 3.5vw, 3rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; margin: 0; overflow-wrap: anywhere; }
  .blog-post h2 a { display: inline-block; padding-block: .25rem; text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .blog-post h2 a:hover { color: var(--signal-text); }
  .blog-post p { color: var(--muted); font-size: 1.125rem; line-height: 1.6; margin: 1rem 0 0; max-width: 58ch; overflow-wrap: anywhere; }
  .blog-empty { border-top: 1px solid var(--line); margin-top: clamp(4rem, 8vw, 7rem); padding-block: 2rem; }
  .blog-empty h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; letter-spacing: -.03em; line-height: 1.15; max-width: 22ch; }
  .blog-empty > p:not(.eyebrow) { color: var(--muted); font-size: 1.125rem; max-width: 48ch; }
  .blog-empty__links { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin-top: 1.5rem; }
</style>
