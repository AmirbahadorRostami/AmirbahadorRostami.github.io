---
import { render, type CollectionEntry } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import BioWordsExperience from '../../components/interactive/BioWordsExperience.astro';
import { getAdjacentProject, getPublishedProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

if (!project?.id) {
  throw new Error(`Missing project entry for route "${Astro.params.slug ?? '(unknown)'}".`);
}

const [{ Content }, { previous, next }] = await Promise.all([
  render(project),
  getAdjacentProject(project.id),
]);
---

<ProjectLayout project={project} previous={previous} next={next}>
  <Content />
  {project.id === 'biowords' && <BioWordsExperience slot="live-experiment" />}
</ProjectLayout>
