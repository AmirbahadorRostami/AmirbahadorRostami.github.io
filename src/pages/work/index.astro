---
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';

const projects = await getPublishedProjects();
---

<BaseLayout title="Work | Amir Bahador Rostami" canonicalPath="/work/" description="Interactive installations, augmented worlds, living simulations, and the technical systems behind five selected projects by Amir Bahador Rostami.">
  <section class="container work-archive" aria-labelledby="work-title">
    <p class="eyebrow">Selected projects</p>
    <h1 id="work-title">Things to enter, follow, swing, listen to, and occasionally get lost inside.</h1>
    <p class="work-archive__intro">Interactive installations, augmented worlds, living simulations, and the technical systems that make them possible.</p>
    <ProjectGrid projects={projects} />
  </section>
</BaseLayout>

<style>
  .work-archive > h1 { max-width: 10ch; }
  .work-archive__intro { color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); margin: 1.5rem 0 0; max-width: 52ch; }
</style>
