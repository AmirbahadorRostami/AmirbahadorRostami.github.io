---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import LiveExperimentSlot from '../components/interactive/LiveExperimentSlot.astro';
import NextProject from '../components/projects/NextProject.astro';
import ProjectFacts from '../components/projects/ProjectFacts.astro';
import ProjectMedia from '../components/projects/ProjectMedia.astro';
import { projectChapters } from '../lib/project-chapters';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  previous: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, previous, next } = Astro.props;
const { data } = project;
const narrative = projectChapters(await Astro.slots.render('default'));
const chapters = [
  { number: '02', title: 'Experience', body: narrative.experience },
  { number: '03', title: 'My contribution', body: narrative.contribution },
  { number: '04', title: 'Technical system', body: narrative.technical },
  { number: '05', title: 'Process', body: narrative.process },
];
---

<BaseLayout title={`${data.title} | Amir Bahador Rostami`} description={data.summary} canonicalPath={`/work/${project.id}/`} image={data.hero.src}>
  <article class="project-detail container" data-project-detail data-depth={data.depth}>
    <header class="project-hero">
      <a class="text-link project-hero__back" href="/work/">← Selected work</a>
      <p class="eyebrow">{String(data.order).padStart(2, '0')} / {data.year ?? 'Project study'}</p>
      <h1>{data.title}</h1>
      <section class="project-premise" data-case-study-chapter="01" aria-labelledby="chapter-01">
        <h2 class="chapter-label" id="chapter-01">01 Premise</h2>
        <p class="project-hero__premise">{data.summary}</p>
      </section>
      <figure class="project-hero__image">
        <Image src={data.hero} alt={data.heroAlt} layout="constrained" loading="eager" fetchpriority="high" />
      </figure>
      <ProjectFacts project={project} />
    </header>

    {chapters.filter(({ body }) => data.depth === 'flagship' || body).map((chapter) => (
      <section class="project-chapter" data-case-study-chapter={chapter.number} aria-labelledby={`chapter-${chapter.number}`}>
        <h2 class="chapter-label" id={`chapter-${chapter.number}`}>{chapter.number} {chapter.title}</h2>
        <div class="project-story__body" set:html={chapter.body} />
      </section>
    ))}

    {(data.depth === 'flagship' || narrative.credits || data.collaborators.length > 0 || data.credits.length > 0) && (
      <section class="project-chapter" data-case-study-chapter="06" aria-labelledby="chapter-06">
        <h2 class="chapter-label" id="chapter-06">06 Credits</h2>
        <div class="project-story__body">
          <Fragment set:html={narrative.credits} />
          {data.collaborators.length > 0 && <div class="project-credit-list"><h3>Collaborators</h3><ul>{data.collaborators.map((name) => <li>{name}</li>)}</ul></div>}
          {data.credits.length > 0 && <ul class="project-credit-list">{data.credits.map((credit) => <li>{credit}</li>)}</ul>}
          {data.outcomes.length > 0 && <div class="project-credit-list"><h3>Outcomes</h3><ul>{data.outcomes.map((outcome) => <li>{outcome}</li>)}</ul></div>}
        </div>
      </section>
    )}

    <section class="project-documentation" data-case-study-chapter="07" aria-labelledby="chapter-07">
      <h2 class="chapter-label" id="chapter-07">07 Documentation</h2>
      {data.externalLinks.length > 0 && <ul class="project-links">{data.externalLinks.map((link) => <li><a class="text-link" href={link.url} rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul>}
      <ProjectMedia project={project} />
    </section>

    <LiveExperimentSlot enabled={data.liveExperiment} title={data.title}>
      <slot name="live-experiment" />
    </LiveExperimentSlot>
    <NextProject previous={previous} next={next} />
  </article>
</BaseLayout>

<style>
  .project-detail { display: grid; gap: clamp(3.5rem, 8vw, 8rem); grid-template-columns: minmax(0, 1fr); }
  .project-hero { display: grid; gap: clamp(1.5rem, 3vw, 3rem); }
  .project-hero__back { justify-self: start; }
  .project-hero .eyebrow { margin: 0; }
  .project-hero h1 { font-size: clamp(3.25rem, 8.5vw, 8rem); margin: 0; max-width: 14ch; overflow-wrap: anywhere; }
  .project-premise { display: grid; gap: 1.5rem; grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr); margin-top: clamp(1rem, 3vw, 3rem); }
  .chapter-label { align-self: start; margin: 0; }
  .project-hero__premise { font-size: clamp(1.35rem, 3vw, 2.5rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.35; margin: 0; max-width: 36ch; }
  .project-hero__image { background: var(--surface); border: 1px solid var(--line); margin: clamp(1rem, 3vw, 3rem) 0 0; overflow: hidden; }
  .project-hero__image :global(img) { height: auto; max-height: 48rem; object-fit: cover; width: 100%; }
  .project-detail[data-depth='short'] .project-hero__image { max-width: 64rem; width: 100%; }
  .project-chapter { border-top: 1px solid var(--line); display: grid; gap: 2rem; grid-template-columns: minmax(10rem, 1fr) minmax(0, 2fr); padding-top: 1.5rem; }
  .project-chapter:nth-of-type(even) .project-story__body { max-width: 42rem; }
  .project-story__body { color: var(--paper); font-size: clamp(1.05rem, 1.8vw, 1.3rem); max-width: 46rem; }
  .project-story__body :global(h3) { color: var(--muted); font-size: 1rem; font-weight: 400; margin: 0 0 1rem; }
  .project-story__body :global(p) { margin: 0 0 1.5rem; }
  .project-story__body :global(p:last-child) { margin-bottom: 0; }
  .project-story__body :global(a) { color: var(--signal-text); text-underline-offset: .25em; }
  .project-story__body :global(code) { font-family: var(--font-mono); font-size: .85em; overflow-wrap: anywhere; }
  .project-credit-list { border-top: 1px solid var(--line); margin-top: 2rem; padding-top: 1.5rem; }
  .project-credit-list ul, ul.project-credit-list { display: grid; font-size: 1rem; gap: .75rem; list-style: none; margin-bottom: 0; padding-left: 0; }
  .project-documentation { border-top: 1px solid var(--line); display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1fr); padding-top: 1.5rem; }
  .project-links { list-style: none; margin: 0; padding: 0; }
  .project-detail[data-depth='short'] { gap: clamp(3rem, 6vw, 5rem); }

  @media (max-width: 44rem) {
    .project-premise, .project-chapter { grid-template-columns: minmax(0, 1fr); }
  }
</style>
