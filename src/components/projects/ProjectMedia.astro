---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { parseYouTubeUrl } from '../../lib/project-media';
import { hasPlayableSources } from '../../lib/experiments';

export interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<div class="project-media" data-project-media>
  {project.data.media.map((media, index) => {
    const youtube = media.externalUrl ? parseYouTubeUrl(media.externalUrl) : undefined;
    const sources = media.sources.filter(source => hasPlayableSources([source]));
    const hasImage = (media.type === 'image' || media.type === 'diagram') && media.image;
    const hasVideo = media.type === 'video' && (sources.length > 0 || media.externalUrl);
    const placeholder = media.state === 'placeholder' || (!hasImage && !hasVideo);

    return (
      <figure id={`media-${media.id}`} data-media-id={media.id} data-media-state={placeholder ? 'placeholder' : 'ready'}>
        <div class="project-media__frame" style={`aspect-ratio: ${media.aspectRatio}`}>
          {placeholder ? (
            <div class="project-media__placeholder">
              <p class="eyebrow">{project.data.title}</p>
              <h3>{media.intention}</h3>
              <dl>
                <div><dt>Media type</dt><dd>{media.type}</dd></div>
                <div><dt>Preferred ratio</dt><dd>{media.aspectRatio}</dd></div>
                <div class="project-media__alt"><dt>Alt text</dt><dd>{media.alt}</dd></div>
                <div><dt>Status</dt><dd>Placeholder — media planned</dd></div>
              </dl>
            </div>
          ) : hasImage && media.image ? (
            <Image src={media.image} alt={media.alt} layout="constrained" loading="lazy" />
          ) : sources.length > 0 ? (
            <video controls preload="none" playsinline poster={media.poster?.src ?? project.data.hero.src} aria-label={media.alt} aria-describedby={`caption-${media.id}`}>
              {sources.map((source) => <source src={source.src} type={source.type} />)}
            </video>
          ) : youtube ? (
            <div class="project-media__video-frame" data-video-facade data-video-id={youtube.videoId} data-video-title={media.caption} data-state="idle">
              {media.poster && <Image class="project-media__poster" src={media.poster} alt="" layout="constrained" loading="lazy" />}
              <button type="button" aria-pressed="false" hidden>
                <span class="project-media__play-icon" aria-hidden="true">▶</span>
                <span>Play {media.caption}</span>
              </button>
              <noscript><p>Watch this video using the YouTube link below.</p></noscript>
            </div>
          ) : (
            <div class="project-media__video-link">
              <p>{media.intention}</p>
              <a href={media.externalUrl} rel="noopener noreferrer" target="_blank" aria-label={`Watch ${media.caption} on its original site`}>Watch on its original site ↗</a>
            </div>
          )}
        </div>
        <figcaption id={`caption-${media.id}`}>
          <span class="project-media__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span>{media.caption}</span>
          {!placeholder && hasVideo && sources.length > 0 && (
            <a href={sources[0].src}>Open {media.intention}</a>
          )}
          {!placeholder && youtube && (
            <a href={`https://www.youtube.com/watch?v=${youtube.videoId}`} rel="noopener noreferrer" target="_blank" aria-label={`Watch ${media.caption} on YouTube`}>Watch on YouTube ↗</a>
          )}
        </figcaption>
      </figure>
    );
  })}
</div>

<style>
  .project-media { display: grid; gap: clamp(2.5rem, 6vw, 6rem) 2rem; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  figure { grid-column: 1 / -1; margin: 0; min-width: 0; scroll-margin-top: 2rem; }
  figure:nth-child(4n + 2) { grid-column: 1 / span 7; }
  figure:nth-child(4n + 3) { grid-column: 9 / span 4; }
  figure:nth-child(4n) { grid-column: 3 / span 10; }
  .project-media__frame { background: var(--surface); border: 1px solid var(--line); display: grid; overflow: hidden; }
  /* The ratio is preferred; documentary text must be able to grow the frame. */
  [data-media-state='placeholder'] .project-media__frame { overflow: visible; }
  .project-media__frame > :global(img), video { height: 100%; object-fit: contain; width: 100%; }
  .project-media__placeholder { align-content: center; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 4rem 4rem; display: grid; gap: clamp(1rem, 2vw, 2rem); padding: clamp(1.25rem, 4vw, 4rem); }
  .project-media__placeholder > * { background: var(--surface); margin: 0; width: fit-content; }
  .project-media__placeholder h3 { font-size: clamp(1.4rem, 3vw, 2.5rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.15; max-width: 20ch; }
  dl { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding: .5rem 0; }
  dt { color: var(--muted); font-family: var(--font-mono); font-size: .625rem; letter-spacing: .06em; text-transform: uppercase; }
  dd { font-size: .8125rem; margin: .3rem 0 0; }
  .project-media__alt { flex-basis: 100%; }
  figcaption { align-items: baseline; color: var(--muted); display: flex; flex-wrap: wrap; font-family: var(--font-mono); font-size: .6875rem; gap: .5rem 1rem; line-height: 1.7; margin-top: 1rem; }
  figcaption > span:nth-child(2) { flex: 1; min-width: 12rem; }
  .project-media__index { color: var(--signal-text); }
  figcaption a, .project-media__video-link a { color: var(--signal-text); min-height: 44px; padding-block: .5rem; text-underline-offset: .3em; }
  .project-media__video-frame { display: grid; position: relative; }
  .project-media__video-frame button { align-items: center; background: var(--surface-raised); border: 1px solid var(--control-border); color: var(--paper); cursor: pointer; display: flex; flex-direction: column; font: inherit; gap: 1rem; grid-area: 1 / 1; justify-content: center; padding: 1.5rem; position: relative; text-align: center; z-index: 1; }
  .project-media__video-frame button[hidden] { display: none; }
  .project-media__video-frame button:hover { border-color: var(--signal); color: var(--signal-text); }
  .project-media__play-icon { color: var(--signal); font-size: clamp(2rem, 8vw, 4rem); line-height: 1; }
  .project-media__video-frame:has(.project-media__poster) button { background: rgb(7 7 7 / .8); }
  .project-media__video-frame :global(.project-media__poster) { grid-area: 1 / 1; height: 100%; object-fit: cover; width: 100%; }
  .project-media__video-frame noscript { align-self: center; grid-area: 1 / 1; padding: 1.5rem; text-align: center; }
  .project-media__video-frame :global(iframe) { border: 0; height: 100%; position: absolute; width: 100%; }
  .project-media__video-link { align-items: center; display: flex; flex-direction: column; gap: 1rem; justify-content: center; padding: 1.5rem; text-align: center; }
  .project-media__video-link p { margin: 0; }

  @media (max-width: 44rem) {
    .project-media { grid-template-columns: minmax(0, 1fr); }
    figure:nth-child(n) { grid-column: 1 / -1; }
  }
</style>

<script>
  for (const facade of document.querySelectorAll<HTMLElement>('[data-video-facade]')) {
    const button = facade.querySelector<HTMLButtonElement>('button');
    if (!button || facade.dataset.initialized === 'true') continue;
    facade.dataset.initialized = 'true';
    button.hidden = false;

    button.addEventListener('click', () => {
      const { videoId, videoTitle } = facade.dataset;
      if (!videoId || !videoTitle) return;
      button.setAttribute('aria-pressed', 'true');
      facade.dataset.state = 'loaded';

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`;
      iframe.title = videoTitle;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allow = 'encrypted-media';
      iframe.allowFullscreen = true;
      button.replaceWith(iframe);
    }, { once: true });
  }
</script>
