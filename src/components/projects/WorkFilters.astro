---
export interface Props {
  categories: string[];
}

const { categories } = Astro.props;
const filterLabel = (category: string) => category.replaceAll('-', ' ');
---

<div class="work-filters" role="group" aria-label="Filter projects by category">
  <button type="button" data-work-filter data-category="all" aria-pressed="true">All projects</button>
  {categories.map((category) => (
    <button type="button" data-work-filter data-category={category} aria-pressed="false">
      {filterLabel(category)}
    </button>
  ))}
</div>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-work-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

  const readCategories = (card: HTMLElement): string[] => {
    const serializedCategories = card.dataset.categories;

    if (!serializedCategories) return [];

    try {
      const categories = JSON.parse(serializedCategories);
      return Array.isArray(categories) && categories.every((category) => typeof category === 'string')
        ? categories
        : [];
    } catch {
      return [];
    }
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.dataset.category;
      if (!category) return;

      filters.forEach((candidate) => {
        candidate.setAttribute('aria-pressed', String(candidate === filter));
      });

      cards.forEach((card) => {
        card.hidden = category !== 'all' && !readCategories(card).includes(category);
      });
    });
  });
</script>

<style>
  .work-filters { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 2rem; }
  button { background: transparent; border: 1px solid var(--control-border); border-radius: 999px; color: var(--paper); cursor: pointer; font: inherit; padding: .45rem .75rem; }
  button:hover, button[aria-pressed='true'] { background: var(--signal); border-color: var(--signal); color: var(--ink); }
</style>
