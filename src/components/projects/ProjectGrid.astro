---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

export interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="project-grid" aria-label="Projects">
  {projects.map((project, index) => (
    <li><ProjectCard project={project} index={index + 1} /></li>
  ))}
</ul>

<style>
  .project-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 2rem 0 0; padding: 0; }
  .project-grid > li { min-width: 0; }

  @media (max-width: 42rem) {
    .project-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
