---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  record: CollectionEntry<'music'>;
  number?: number;
}

const { record, number } = Astro.props;
const { description, duration, platform, title, url } = record.data;
const platformLabels = {
  spotify: 'Spotify',
  soundcloud: 'SoundCloud',
  bandcamp: 'Bandcamp',
  direct: 'Direct link',
} satisfies Record<typeof platform, string>;
const platformLabel = platformLabels[platform];
---

<article class="music-card" data-music-card>
  {number !== undefined && <span class="music-card__number" data-music-number>{String(number).padStart(2, '0')}</span>}
  <div class="music-card__title">
    <h2>{title}</h2>
    {description && <p class="music-card__description">{description}</p>}
  </div>
  <div class="music-card__meta">
    <span class="music-card__platform">{platformLabel}</span>
    {duration && <span class="music-card__duration">{duration}</span>}
  </div>
  <a aria-label={`Listen to ${title} on ${platformLabel}`} href={url} rel="noopener noreferrer" target="_blank">Listen <span aria-hidden="true">↗</span></a>
</article>

<style>
  .music-card { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) auto auto; align-items: center; column-gap: clamp(1rem, 3vw, 2.5rem); min-width: 0; padding: 1.4rem 0; }
  .music-card__title { min-width: 0; }
  .music-card__meta { display: flex; flex-direction: column; gap: .4rem; }
  .music-card__number, .music-card__platform, .music-card__duration { color: var(--signal-text); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .music-card h2 { font-size: clamp(1.4rem, 2.5vw, 2rem); letter-spacing: -.04em; line-height: 1.15; margin: 0; overflow-wrap: anywhere; }
  .music-card__description { color: var(--muted); margin: .6rem 0 0; }
  .music-card a { color: var(--signal-text); display: inline-flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .75rem; letter-spacing: .06em; min-height: 44px; text-decoration: underline; text-underline-offset: .25em; text-transform: uppercase; white-space: nowrap; }

  @media (max-width: 42rem) {
    .music-card { grid-template-columns: 1.75rem minmax(0, 1fr) auto; column-gap: .75rem; row-gap: .5rem; padding: 1.25rem 0; }
    .music-card__number { align-self: start; padding-top: .25rem; }
    .music-card__title { grid-column: 2 / -1; }
    .music-card__meta { grid-column: 2; flex-direction: row; flex-wrap: wrap; gap: .5rem; }
    .music-card a { grid-column: 3; }
  }
</style>
