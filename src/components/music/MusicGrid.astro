---
import type { CollectionEntry } from 'astro:content';
import MusicCard from './MusicCard.astro';

export interface Props {
  records: CollectionEntry<'music'>[];
  startIndex?: number;
}

const { records, startIndex = 1 } = Astro.props;
---

<ul class="music-grid" data-music-grid>
  {records.map((record, index) => (
    <li><MusicCard record={record} number={startIndex + index} /></li>
  ))}
</ul>

<style>
  .music-grid { display: grid; gap: 1px; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 1.5rem 0 0; padding: 1px; background: var(--line); }
  .music-grid > li { min-width: 0; }

  @media (max-width: 58rem) {
    .music-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 42rem) {
    .music-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
