<div class="ten-print" data-ten-print data-render-state="fallback" data-animation-state="fallback" data-motion="full" aria-hidden="true">
  <img src="/media/ten-print-fallback.svg" alt="" aria-hidden="true" />
  <div class="ten-print__mount" data-ten-print-mount></div>
</div>

<style>
  .ten-print { inset: 0; overflow: hidden; pointer-events: none; position: absolute; }
  .ten-print img,
  .ten-print__mount { height: 100%; inset: 0; position: absolute; width: 100%; }
  .ten-print img { object-fit: cover; }
  .ten-print__mount { opacity: 0; }
  :global(html[data-js='enabled']) .ten-print[data-render-state='fallback'] img { visibility: hidden; }
  .ten-print[data-render-state='ready'] img,
  .ten-print[data-render-state='paused'] img { visibility: hidden; }
  .ten-print[data-render-state='ready'] .ten-print__mount,
  .ten-print[data-render-state='paused'] .ten-print__mount { opacity: 1; }
  .ten-print__mount :global(canvas) { display: block; height: 100%; width: 100%; }
</style>

<script>
  import { createTenPrintCells, getTenPrintRevealCount, getTenPrintRevealGeometry, type TenPrintCell } from '../../lib/ten-print';

  const field = document.querySelector<HTMLElement>('[data-ten-print]');
  const mount = field?.querySelector<HTMLElement>('[data-ten-print-mount]');

  if (field && mount) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let application: import('pixi.js').Application | null = null;
    let drawing: import('pixi.js').Graphics | null = null;
    let initializing = false;
    let disposed = false;
    let intersecting = false;
    let dirty = true;
    let resizeTimer: number | undefined;
    let animationFrame: number | undefined;
    let lastFrame: number | null = null;
    let elapsedMs = 0;
    let cells: TenPrintCell[] = [];
    let revealed = 0;
    let drawnWidth = 0;
    let drawnHeight = 0;
    const durationMs = 4000;

    const isActive = () => intersecting && document.visibilityState === 'visible';

    const stopAnimation = () => {
      if (animationFrame !== undefined) window.cancelAnimationFrame(animationFrame);
      animationFrame = undefined;
      lastFrame = null;
    };

    const paintThrough = (target: number) => {
      if (!application || target <= revealed) return;
      const { fullRowsHeight, partialRowY, partialRowWidth } = getTenPrintRevealGeometry(
        target,
        Math.ceil(drawnWidth / 40),
        40,
      );
      const partialRowBottom = Math.min(drawnHeight, partialRowY + 40);
      application.canvas.style.clipPath = target === cells.length
        ? 'none'
        : `polygon(0 0, ${drawnWidth}px 0, ${drawnWidth}px ${fullRowsHeight}px, ${partialRowWidth}px ${fullRowsHeight}px, ${partialRowWidth}px ${partialRowBottom}px, 0 ${partialRowBottom}px)`;
      revealed = target;
      if (revealed === cells.length) field.dataset.animationState = 'complete';
    };

    const tick = (timestamp: number) => {
      animationFrame = undefined;
      if (!isActive() || motion.matches || !application) return;
      if (lastFrame !== null) elapsedMs += Math.max(0, timestamp - lastFrame);
      lastFrame = timestamp;
      paintThrough(getTenPrintRevealCount(cells.length, elapsedMs, durationMs));
      if (revealed < cells.length) animationFrame = window.requestAnimationFrame(tick);
    };

    const startAnimation = () => {
      if (animationFrame !== undefined || revealed >= cells.length) return;
      field.dataset.animationState = 'drawing';
      animationFrame = window.requestAnimationFrame(tick);
    };

    const resetField = () => {
      if (!application || !drawing || !isActive()) return;
      stopAnimation();
      drawnWidth = Math.max(1, Math.ceil(mount.clientWidth));
      drawnHeight = Math.max(1, Math.ceil(mount.clientHeight));
      application.renderer.resize(drawnWidth, drawnHeight);
      drawing.clear();
      cells = createTenPrintCells({ width: drawnWidth, height: drawnHeight, cellSize: 40, seed: 1982 });
      for (const { x, y, size, direction, alpha, tone } of cells) {
        const startX = direction === 'forward' ? x : x + size;
        const endX = direction === 'forward' ? x + size : x;
        drawing.moveTo(startX, y).lineTo(endX, y + size).stroke({
          width: tone > 0.82 ? 2.2 : 1.3,
          color: tone > 0.7 ? 0xd54e3d : 0xa71414,
          alpha,
        });
      }
      revealed = 0;
      elapsedMs = 0;
      dirty = false;
      // Render once; the browser reveals the finished canvas without rebuilding Pixi geometry.
      application.canvas.style.clipPath = 'polygon(0 0, 0 0, 0 0)';
      application.renderer.render(application.stage);
      field.dataset.renderState = 'ready';
      if (motion.matches) paintThrough(cells.length);
      else startAnimation();
    };

    const initialize = async () => {
      if (application || initializing || disposed || !isActive()) return;
      initializing = true;
      let nextApplication: import('pixi.js').Application | null = null;
      try {
        const { Application, Graphics } = await import('pixi.js');
        if (disposed) return;
        nextApplication = new Application();
        await nextApplication.init({
          backgroundAlpha: 0,
          antialias: true,
          autoDensity: true,
          preference: 'webgl',
          resolution: Math.min(window.devicePixelRatio || 1, 2),
          width: Math.max(1, mount.clientWidth),
          height: Math.max(1, mount.clientHeight),
        });
        if (disposed) {
          nextApplication.destroy(true);
          return;
        }
        nextApplication.ticker.stop();
        drawing = new Graphics();
        nextApplication.stage.addChild(drawing);
        nextApplication.canvas.style.clipPath = 'polygon(0 0, 0 0, 0 0)';
        mount.appendChild(nextApplication.canvas);
        application = nextApplication;
        updateState();
      } catch {
        try {
          nextApplication?.destroy(true);
        } catch {
          // An app whose renderer never initialized may not be destroyable.
        }
        application = null;
        drawing = null;
        mount.replaceChildren();
        if (!disposed) {
          field.dataset.renderState = 'error';
          field.dataset.animationState = 'fallback';
        }
      } finally {
        initializing = false;
      }
    };

    const updateState = () => {
      field.dataset.motion = motion.matches ? 'reduced' : 'full';
      if (!isActive()) {
        stopAnimation();
        if (application) {
          field.dataset.renderState = 'paused';
          if (revealed < cells.length && !motion.matches) field.dataset.animationState = 'paused';
        }
        return;
      }
      if (!application) {
        if (field.dataset.renderState !== 'error') void initialize();
        return;
      }
      if (dirty) {
        resetField();
        return;
      }
      field.dataset.renderState = 'ready';
      if (motion.matches) {
        stopAnimation();
        if (revealed < cells.length) paintThrough(cells.length);
      } else if (revealed < cells.length) {
        startAnimation();
      }
    };

    const observer = new IntersectionObserver(([entry]) => {
      intersecting = entry?.isIntersecting ?? false;
      updateState();
    });
    const resizeObserver = new ResizeObserver(() => {
      const width = Math.max(1, Math.ceil(mount.clientWidth));
      const height = Math.max(1, Math.ceil(mount.clientHeight));
      if (width === drawnWidth && height === drawnHeight) return;
      dirty = true;
      window.clearTimeout(resizeTimer);
      if (isActive()) resizeTimer = window.setTimeout(updateState, 120);
    });
    const dispose = () => {
      disposed = true;
      stopAnimation();
      observer.disconnect();
      resizeObserver.disconnect();
      window.clearTimeout(resizeTimer);
      document.removeEventListener('visibilitychange', updateState);
      document.removeEventListener('astro:before-swap', dispose);
      motion.removeEventListener('change', updateState);
      application?.destroy(true);
      application = null;
      drawing = null;
    };

    observer.observe(field);
    resizeObserver.observe(mount);
    document.addEventListener('visibilitychange', updateState);
    document.addEventListener('astro:before-swap', dispose);
    motion.addEventListener('change', updateState);
    updateState();
  }
</script>
