<div data-biowords data-status="ready" data-render-state="fallback">
  <p>Your text stays in this browser and is never stored or sent. Only surviving original words return, ordered by survival time, then remaining energy.</p>
  <label for="biowords-input">Words for the ecosystem</label>
  <textarea id="biowords-input" maxlength="280" aria-describedby="biowords-help biowords-count">signals gather softly</textarea>
  <p id="biowords-count" data-biowords-count aria-live="polite">21 / 280 characters</p>
  <div class="controls">
    <button type="button" data-action="begin">Begin</button>
    <button type="button" data-action="pause" disabled>Pause</button>
    <button type="button" data-action="resume" disabled>Resume</button>
    <button type="button" data-action="restart" disabled>Restart</button>
    <button type="button" data-action="skip" disabled>Skip to Result</button>
  </div>
  <p data-biowords-status role="status" aria-live="polite" aria-atomic="true">Ready. Enter words and choose Begin.</p>
  <p class="fallback" id="biowords-help">Words become creatures, gather into communities, and compete for energy. The controls and written result work even when the visual ecosystem is unavailable. With reduced motion, Begin and Resume advance half a second at a time.</p>
  <div data-biowords-mount aria-hidden="true"></div>
  <h3>Surviving words</h3>
  <p data-biowords-result aria-live="polite" aria-atomic="true"></p>
  <noscript><p>Enable JavaScript to run this local experiment. The project story and ecosystem description remain available above.</p></noscript>
</div>
<style>
  [data-biowords] { min-width: 0; }
  textarea { display: block; box-sizing: border-box; width: 100%; max-width: 100%; min-height: 6rem; margin-top: .5rem; background: var(--ink); color: var(--paper); border: 1px solid var(--muted); padding: .75rem; font: inherit; }
  .controls { display: flex; flex-wrap: wrap; gap: .5rem; }
  button { min-width: 44px; min-height: 44px; padding: .7rem 1rem; background: var(--paper); color: var(--ink); border: 1px solid var(--paper); font: inherit; cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  button:focus-visible, textarea:focus-visible { outline: 3px solid var(--signal-text); outline-offset: 4px; }
  [data-biowords-mount] { height: 320px; width: 100%; overflow: hidden; border-block: 1px solid var(--line); }
  [data-biowords-mount] :global(canvas) { display: block; width: 100%; height: 100%; }
  [data-biowords-result] { overflow-wrap: anywhere; font-size: 1.5rem; }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-biowords]');
  if (root) {
    const { mountBioWords } = await import('../../lib/biowords/controller');
    mountBioWords(root);
  }
</script>
