---
import TenPrintField from '../interactive/TenPrintField.astro';
import { SITE } from '../../config/site';
---

<section id="hero" class="hero">
  <div class="container hero__content">
    <p class="eyebrow">Creative technologist / musician / nerd</p>
    <h1>Part engineer. Part musician. Entirely too curious.</h1>
    <p class="hero__introduction">
      I design and build interactive systems, immersive artworks, and digital experiences that explore how technology can change the way people connect.
    </p>
    <ul class="hero__facts" aria-label="Location">
      <li>{SITE.location}</li>
    </ul>
    <div class="hero__actions">
      <a class="hero__link" href="#selected-work">See what I've been building <span aria-hidden="true">↓</span></a>
      <a class="hero__link" href="/contact/">Work with me <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <TenPrintField />
</section>

<style>
  .hero {
    align-items: center;
    display: flex;
    min-height: calc(100svh - 4.5rem);
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vh, 5rem);
    position: relative;
  }

  .hero::after {
    background: var(--hero-art-scrim);
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero__content { position: relative; z-index: 1; }
  .eyebrow { margin: 0; }
  h1 { font-size: clamp(2.75rem, min(8vw, 11vh), 7rem); max-width: 12ch; }
  .hero__introduction { color: var(--muted); font-size: clamp(1rem, min(2vw, 2.5vh), 1.4rem); margin: clamp(1.1rem, 3vh, 2rem) 0 0; max-width: 42rem; }
  .hero__facts { display: flex; flex-wrap: wrap; font-family: var(--font-mono); font-size: .8rem; gap: .5rem 1.5rem; list-style: none; margin: clamp(.9rem, 2.5vh, 1.5rem) 0 0; padding: 0; }
  .hero__facts li { align-items: center; display: inline-flex; gap: .65rem; }
  .hero__facts li::before { background: var(--signal); border-radius: 50%; content: ''; height: .45rem; width: .45rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: clamp(1rem, 3vh, 2rem); }
  .hero__link { align-items: center; color: var(--signal-text); display: inline-flex; font-family: var(--font-mono); gap: .55rem; min-height: 44px; text-decoration-thickness: 1px; text-underline-offset: .3em; }

  @media (max-width: 42rem) {
    .hero { min-height: calc(100svh - 4.5rem); padding-block: 1.25rem; }
    h1 { font-size: clamp(2.15rem, 11.5vw, 3.25rem); }
    .hero__introduction { font-size: .9rem; line-height: 1.35; margin-top: .8rem; }
    .hero__facts { font-size: .65rem; margin-top: .65rem; }
    .hero__actions { align-items: flex-start; flex-direction: column; font-size: .78rem; gap: .25rem; margin-top: .65rem; }
  }
</style>
