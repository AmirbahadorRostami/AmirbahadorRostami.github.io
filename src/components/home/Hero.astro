---
import SignalField from '../interactive/SignalField.astro';
import { SITE } from '../../config/site';
---

<section id="hero" class="hero">
  <SignalField />
  <div class="container hero__content">
    <p class="eyebrow">Creative technologist / musician / nerd</p>
    <h1>Creative tinkerer. Musician. Professional maker of curious things.</h1>
    <p class="hero__introduction">
      I create immersive experiences, software, and sound that bring people together in unexpected ways.
    </p>
    <ul class="hero__facts" aria-label="Location and availability">
      <li>{SITE.location}</li>
      <li>Open to employment and freelance work.</li>
    </ul>
    <div class="hero__actions">
      <a class="hero__link" href="#selected-work">Follow the curious signal <span aria-hidden="true">↓</span></a>
      <a class="hero__link" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    min-height: calc(100svh - 4.5rem);
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vh, 5rem);
    position: relative;
  }

  .hero::after {
    background: linear-gradient(90deg, var(--ink) 12%, transparent 78%);
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero__content { position: relative; z-index: 1; }
  .eyebrow { margin: 0; }
  h1 { font-size: clamp(2.75rem, min(8vw, 11vh), 7rem); max-width: 12ch; }
  .hero__introduction { color: var(--muted); font-size: clamp(1rem, min(2vw, 2.5vh), 1.4rem); margin: clamp(1.1rem, 3vh, 2rem) 0 0; max-width: 42rem; }
  .hero__facts { display: flex; flex-wrap: wrap; font-family: var(--font-mono); font-size: .8rem; gap: .5rem 1.5rem; list-style: none; margin: clamp(.9rem, 2.5vh, 1.5rem) 0 0; padding: 0; }
  .hero__facts li { align-items: center; display: inline-flex; gap: .65rem; }
  .hero__facts li::before { background: var(--signal); border-radius: 50%; content: ''; height: .45rem; width: .45rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: clamp(1rem, 3vh, 2rem); }
  .hero__link { color: var(--signal); display: inline-flex; font-family: var(--font-mono); gap: .55rem; text-decoration-thickness: 1px; text-underline-offset: .3em; }

  @media (max-width: 42rem) {
    .hero { min-height: calc(100svh - 4.5rem); padding-block: 1.75rem; }
    .hero::after { background: linear-gradient(90deg, var(--ink) 25%, rgb(8 9 11 / .48)); }
    h1 { font-size: clamp(2.35rem, 13vw, 3.25rem); }
    .hero__introduction { line-height: 1.45; margin-top: 1rem; }
    .hero__facts { font-size: .7rem; margin-top: .85rem; }
    .hero__actions { align-items: flex-start; flex-direction: column; margin-top: 1rem; }
  }
</style>
