---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  records: CollectionEntry<'music'>[];
}

const { records } = Astro.props;
const featuredOrder = ['Float', 'Flow', 'La Paloma'];
const orderedRecords = [...records].sort(
  (left, right) => featuredOrder.indexOf(left.data.title) - featuredOrder.indexOf(right.data.title),
);
---

<section id="selected-music" class="selected-music">
  <div class="container selected-music__inner">
    <div class="selected-music__introduction">
      <p class="eyebrow">Selected music</p>
      <h2>Signals for headphones and open rooms.</h2>
      <p>Compositions, remixes, and sonic experiments from the same curious workshop.</p>
    </div>
    <div class="music-grid" data-music-grid>
      {orderedRecords.map(({ data }) => (
        <article class="music-card" data-music-card>
          <p class="music-card__platform">{data.platform}</p>
          <h3>{data.title}</h3>
          {data.description && <p>{data.description}</p>}
          <a href={data.url} target="_blank" rel="noreferrer">Listen to {data.title}</a>
        </article>
      ))}
      <a class="music-card music-card--gateway" data-music-gateway href="/music/">
        <p class="music-card__platform">The full frequency</p>
        <h3>More music</h3>
        <span>Open the music archive <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .selected-music { border-bottom: 1px solid var(--line); padding-block: clamp(4rem, 10vw, 8rem); }
  .selected-music__inner { display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: minmax(14rem, .7fr) minmax(0, 1.3fr); }
  .selected-music__introduction { align-self: start; position: sticky; top: 2rem; }
  h2 { font-size: clamp(2.2rem, 5vw, 4rem); letter-spacing: -.055em; line-height: 1; margin: .75rem 0 0; max-width: 11ch; }
  .selected-music__introduction > p:last-child { color: var(--muted); margin: 1.5rem 0 0; max-width: 29rem; }
  .music-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .music-card { background: var(--surface-raised); border: 1px solid var(--line); display: flex; flex-direction: column; min-height: 15rem; min-width: 0; padding: 1.5rem; text-decoration: none; }
  .music-card__platform { color: var(--signal); font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; margin: 0; text-transform: uppercase; }
  .music-card h3 { font-size: clamp(1.65rem, 4vw, 2.7rem); letter-spacing: -.05em; line-height: 1; margin: auto 0 1rem; }
  .music-card > p:not(.music-card__platform) { color: var(--muted); }
  .music-card a, .music-card > span { color: var(--signal); font-weight: 700; text-decoration: underline; text-underline-offset: .25em; }
  .music-card--gateway { background: color-mix(in srgb, var(--signal) 12%, var(--surface-raised)); }
  .music-card--gateway:hover { border-color: var(--signal); }

  @media (max-width: 54rem) {
    .selected-music__inner { grid-template-columns: minmax(0, 1fr); }
    .selected-music__introduction { position: static; }
  }

  @media (max-width: 42rem) {
    .music-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
