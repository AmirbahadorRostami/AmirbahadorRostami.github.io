{
  "name": "amir-rostami-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:prepare:videos": "node scripts/prepare-videos.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e && npm run test:e2e:contact-fallback",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:contact-fallback": "PLAYWRIGHT_CONTACT_ENDPOINT='' PLAYWRIGHT_INCLUDE_CONTACT_FALLBACK=true playwright test tests/e2e/contact-fallback.spec.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/sitemap": "^3.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^6.0.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.21.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "vitest": "^3.2.0"
  }
}
